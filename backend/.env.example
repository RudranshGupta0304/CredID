# Prototype mode. Set false in deployed environments and configure JWT_SECRET_KEY.
DEMO_MODE=true
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Optional real EVM testnet anchoring. Keep the private key server-side only.
BLOCKCHAIN_NETWORK=Your configured testnet
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_ANCHOR_ADDRESS=
